# ------------------------------------------------------------
# HYPNOSCOUT proxy configuration
# Copy this file to ".env" and fill in your values.
# ------------------------------------------------------------

# Your Clash Royale API bearer token.
# Get one at https://developer.clashroyale.com  (see README.md)
CR_API_TOKEN=

# Port the proxy listens on (frontend defaults to 8787)
PORT=8787

# Restrict which origin may call the proxy. Use * for local dev,
# or your site's URL in production, e.g. https://hypnoscout.com
ALLOW_ORIGIN=*

# YouTube channel id for the "Son Videolar" (latest videos) section.
# @hypnoscr resolves to the id below.
YT_CHANNEL_ID=UC5pUCwGNR9rnoWLfweHcnRw
