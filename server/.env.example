# ------------------------------------------------------------
# HYPNOSHUB — sunucu ayarları
# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env ASLA depoya girmez.
# Yayında (Railway vb.) bu değerler "Variables" ekranından girilir.
# ------------------------------------------------------------

# --- ZORUNLU ---

# Clash Royale API anahtarı. https://developer.clashroyale.com
# DİKKAT: anahtar oluştururken bir IP yazmanız istenir ve yalnızca o
# IP'den gelen istek kabul edilir.
CR_API_TOKEN=

# --- YAYINDA ZORUNLU, YERELDE GEREKSİZ ---

# Verinin yazılacağı klasör (hesaplar, puan tablosu, mesajlar, indeks).
# Boş bırakılırsa server/.cache kullanılır.
#
# BULUTTA MUTLAKA DOLDURUN. Railway/Render gibi yerlerde uygulamanın
# diski GEÇİCİDİR: her yeni sürümde sıfırlanır. Kalıcı bir disk (Railway'de
# "Volume") bağlayıp onun yolunu buraya yazın, yoksa her yayında bütün
# kullanıcı hesapları ve puan tablosu silinir.
# DATA_DIR=/data

# Clash Royale API adresi. Boşsa doğrudan Supercell'e gidilir.
#
# Bulutta sunucunun dışa çıkış IP'si sabit olmadığı için IP'ye bağlı
# anahtar çalışmaz. Çözüm RoyaleAPI vekili: anahtarı 45.79.218.79 IP'sine
# kayıtlı açın ve aşağıdaki satırı açın.
# CR_API_BASE=https://proxy.royaleapi.dev/v1

# Yönetici hesapları (virgülle ayrılmış kullanıcı adları).
# Boşsa ilk kayıt olan hesap yönetici sayılır.
# ADMIN_USERS=Ahmet23

# --- İSTEĞE BAĞLI ---

# Sunucunun dinleyeceği port. Bulutta sağlayıcı kendisi atar, dokunmayın.
PORT=8787

# Proxy'yi hangi sitenin çağırabileceği. Site ile API aynı adreste
# olduğu için normalde gerekmez.
ALLOW_ORIGIN=*

# Oyuncu ADI ile arama için taranacak klan sayısı.
# 0 = indeks kapalı: bellek kullanımı ~1,5 GB düşer ve açılış hızlanır,
# ama arama yalnızca #etiket ile çalışır. Küçük sunucuda 0 yapın.
CRAWL_CLANS=250000

# "Son Videolar" bölümünün YouTube kanal kimliği.
YT_CHANNEL_ID=UC5pUCwGNR9rnoWLfweHcnRw
